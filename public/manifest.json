{
    "name": "NipponGo",
    "short_name": "NipponGo",
    "description": "Dein Japan Reisebegleiter — Dashboard, Planung und Reise-Tools",
    "start_url": "/",
    "id": "/",
    "display": "standalone",
    "display_override": [
        "window-controls-overlay",
        "standalone"
    ],
    "background_color": "#ffffff",
    "theme_color": "#007AFF",
    "orientation": "portrait-primary",
    "scope": "/",
    "dir": "ltr",
    "lang": "de",
    "categories": [
        "travel",
        "lifestyle"
    ],
    "prefer_related_applications": false,
    "related_applications": [],
    "iarc_rating_id": "",
    "scope_extensions": [],
    "icons": [
